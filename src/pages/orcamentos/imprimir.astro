---
import PrintView from "../../components/orcamentos/PrintView.tsx"
---

<!doctype html>
<html lang="pt">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Orçamento · GPTur</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      body { margin: 0; background: #eceae4; }
      .sheet { background: #fff; width: 210mm; margin: 24px auto; box-shadow: 0 4px 24px rgba(0, 0, 0, 0.1); }
      @page { size: 210mm 297mm; margin: 0; }
      .toolbar {
        position: sticky; top: 0; z-index: 10; display: flex; align-items: center; gap: 14px;
        background: #26302e; color: #fff; padding: 10px 18px; font-family: "Manrope", sans-serif; font-size: 13px;
      }
      .toolbar button {
        background: #2a6b61; color: #fff; border: 0; border-radius: 6px; padding: 8px 16px;
        font-weight: 600; font-size: 13px; cursor: pointer;
      }
      .toolbar button:hover { background: #235650; }
      .toolbar label { display: inline-flex; align-items: center; gap: 6px; color: #c9d2cf; }
      .toolbar select { border: 1px solid rgba(255, 255, 255, 0.2); background: #33413d; color: #fff; border-radius: 6px; padding: 6px 8px; font-size: 12px; }
      .toolbar select option { color: #000; }
      @media print {
        body { background: #fff; }
        .noprint { display: none !important; }
        .sheet { width: auto; margin: 0; box-shadow: none; }
      }
    </style>
  </head>
  <body>
    <PrintView client:only="react" />
  </body>
</html>
